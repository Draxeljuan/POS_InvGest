# ==============================================================================
# InvenGest_POS — Variables de Entorno (Plantilla de Ejemplo - Cero Secretos)
# Copiar a .env: cp .env.example .env
# Cubre el 100 % de variables usadas en los 6 application.properties y docker-compose.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL Unificada (invengest_pos con 4 esquemas)
# ------------------------------------------------------------------------------
DB_HOST=postgres-invengest
DB_PORT=5432
DB_NAME=invengest_pos
DB_USER=invengest_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Esquemas por microservicio (aislamiento lógico sin FKs cruzadas)
DB_SCHEMA_AUTH=auth
DB_SCHEMA_CATALOG=catalog
DB_SCHEMA_TRANSACTION=transaction
DB_SCHEMA_ANALYTICS=analytics

# Pool HikariCP optimizado (< 500 ms y compatible con límites de nube)
DB_POOL_MAX=5
DB_POOL_MIN_IDLE=2
DB_CONN_TIMEOUT_MS=2000

# ------------------------------------------------------------------------------
# 2. Seguridad JWT y Comunicación Interna (Defensa en Profundidad)
# ------------------------------------------------------------------------------
# Mínimo 256 bits (32+ bytes / clave Base64 de 44+ caracteres) para HS256
JWT_SECRET=CHANGE_ME_GENERATE_256_BIT_SECRET_KEY_MINIMUM_32_CHARS
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=invengest-pos-auth

# Llave compartida para proteger rutas /internal/** entre microservicios
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_SERVICE_API_KEY_2026

# ------------------------------------------------------------------------------
# 3. Usuario Administrador Inicial (Semilla por ApplicationRunner en auth-service)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_INITIAL_PASSWORD
ADMIN_EMAIL=admin@invengest.local
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=Principal
ADMIN_TELEFONO=3000000000

# ------------------------------------------------------------------------------
# 4. Puertos y URLs Inter-Servicio (API Gateway y OpenFeign)
# ------------------------------------------------------------------------------
# Único puerto expuesto al host en docker-compose.yml
GATEWAY_PORT=8080
API_GATEWAY_PORT=8080

# Puertos internos de cada microservicio
AUTH_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082
TRANSACTION_SERVICE_PORT=8083
ANALYTICS_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# URLs de comunicación en la red interna Docker (o URLs privadas en Render)
AUTH_SERVICE_URL=http://auth-service:8081
CATALOG_SERVICE_URL=http://catalog-service:8082
TRANSACTION_SERVICE_URL=http://transaction-service:8083
ANALYTICS_SERVICE_URL=http://analytics-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8085

# Timeouts explícitos del API Gateway Reactivo (Netty)
GATEWAY_CONNECT_TIMEOUT_MS=500
GATEWAY_RESPONSE_TIMEOUT=3000ms

# Timeouts explícitos de clientes OpenFeign (ms)
FEIGN_CONNECT_TIMEOUT_MS=300
FEIGN_READ_TIMEOUT_MS=1200
FEIGN_NOTIFICATION_READ_TIMEOUT_MS=800

# ------------------------------------------------------------------------------
# 5. Microservicio de Notificaciones (Stateless — Spring Boot Mail @Async)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=notificaciones@tu-dominio.com
SPRING_MAIL_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
SPRING_MAIL_FROM=no-reply@invengest.local
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
SPRING_MAIL_STARTTLS_REQUIRED=true
SPRING_MAIL_CONNECTION_TIMEOUT_MS=3000
SPRING_MAIL_TIMEOUT_MS=5000
SPRING_MAIL_WRITE_TIMEOUT_MS=5000

# Alias de compatibilidad para SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@tu-dominio.com
MAIL_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
MAIL_FROM=no-reply@invengest.local
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Pool de hilos @Async dedicado para envío de correos
NOTIFICATION_ASYNC_CORE_POOL=2
NOTIFICATION_ASYNC_MAX_POOL=4
NOTIFICATION_ASYNC_QUEUE_CAPACITY=50

# ------------------------------------------------------------------------------
# 6. APIs Externas Gratuitas y Caché (TRM DolarAPI y Días Festivos Colombia)
# ------------------------------------------------------------------------------
DOLAR_API_URL=https://co.dolarapi.com/v1/trm
FESTIVOS_API_URL=https://api-colombia.com/api/v1/Holiday/year
EXT_API_CONNECT_TIMEOUT_MS=300
EXT_API_READ_TIMEOUT_MS=700

TRM_CACHE_TTL_SECONDS=3600
TRM_CACHE_PRELOAD_ENABLED=true

FESTIVOS_CACHE_TTL_SECONDS=86400
FESTIVOS_CACHE_PRELOAD_ENABLED=true

# ------------------------------------------------------------------------------
# 7. CORS Global (API Gateway)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# ------------------------------------------------------------------------------
# 8. Ajuste de Memoria JVM para Contenedores (Hostinger VPS KVM 2 — 8 GB RAM)
# ------------------------------------------------------------------------------
JAVA_TOOL_OPTIONS_DEFAULT=-Xms192m -Xmx384m -XX:+UseSerialGC -Xss512k
JAVA_TOOL_OPTIONS_MEDIUM=-Xms256m -Xmx480m -XX:+UseSerialGC -Xss512k
JAVA_TOOL_OPTIONS_ANALYTICS=-Xms256m -Xmx576m -XX:+UseSerialGC -Xss512k
